{
  "_comment": "Template data every project page inherits. A project's project.json 'display' block and its optional overrides/data.json are deep-merged on top. Ported from the 'Digital Reality - KPIs (Committed)' Power BI model. Changing this file changes every project on the next build; its hash is recorded in each P<key>/manifest.json.",

  "eyebrow": "TSUK",
  "locale": "en-IN",
  "staleAfterHours": 20,

  "_taskTypes": "RowData: Table.SelectRows taskType = Construction or Design",
  "taskTypes": ["Construction", "Design"],

  "ppc": {
    "_comment": "targetPct = the model's min% measure (.85). trendWeeks = weeks drawn on the weekly PPC chart; the last six are the L6W window.",
    "targetPct": 85,
    "trendWeeks": 12,
    "_rollingWeeks": "PPC review export: weeks in the rolling average PPC (the model's 6-week running PPC).",
    "rollingWeeks": 6
  },

  "score": {
    "_comment": "!!@Total Score. bands are tried in order: [operator, threshold, points]; no match = else. Units: percent for ppc/activityDelayed/constraintsOverdue, days for avgDelay/plannedDuration, tasks per week for weeklyPlanned. status: [min score, label, tone], first match wins, else Red.",
    "components": [
      { "key": "ppc", "label": "PPC (6-week running)", "unit": "%", "weight": 0.35,
        "bands": [[">=", 85, 100], [">=", 75, 80], [">=", 65, 60], [">=", 55, 40]], "else": 20 },
      { "key": "activityDelayed", "label": "Activities delayed", "unit": "%", "weight": 0.15,
        "bands": [["<=", 5, 100], ["<=", 10, 80], ["<=", 20, 60], ["<=", 30, 40]], "else": 20 },
      { "key": "constraintsOverdue", "label": "Constraints overdue", "unit": "%", "weight": 0.15,
        "bands": [["<=", 5, 100], ["<=", 10, 80], ["<=", 20, 60], ["<=", 30, 40]], "else": 20 },
      { "key": "avgDelay", "label": "Avg. delay duration", "unit": "d", "weight": 0.15,
        "bands": [["<=", 3, 100], ["<=", 7, 80], ["<=", 14, 60], ["<=", 30, 40]], "else": 20 },
      { "key": "plannedDuration", "label": "Avg. planned duration", "unit": "d", "weight": 0.10,
        "bands": [["<=", 6, 100], ["<=", 8, 80], ["<=", 10, 60], ["<=", 12, 40]], "else": 20 },
      { "key": "weeklyPlanned", "label": "Weekly planned activities", "unit": "", "weight": 0.10,
        "bands": [[">", 70, 100], [">=", 61, 80], [">=", 41, 60], [">=", 30, 40]], "else": 20 }
    ],
    "status": [[75, "Green", "good"], [50, "Amber", "warn"]]
  },

  "tolerance": {
    "_comment": "Tolerance_Limits table: good / watch rules, anything else is critical.",
    "weeklyPlanned":      { "label": "Weekly Planned Activities",      "good": [">=", 100], "watch": [">=", 50], "text": ["≥ 100", "50 – 100", "< 50"] },
    "ppc":                { "label": "% Plan Complete (PPC)",          "good": [">=", 80],  "watch": [">=", 65], "text": ["≥ 80%", "65 – 79%", "< 65%"] },
    "activityDelayed":    { "label": "% Activities Delayed",           "good": ["<=", 5],   "watch": ["<=", 15], "text": ["≤ 5%", "6 – 15%", "> 15%"] },
    "avgDelay":           { "label": "Avg. Delay Duration (Days)",     "good": ["<=", 5],   "watch": ["<=", 15], "text": ["≤ 5 days", "6 – 15 days", "> 15 days"] },
    "constraintsOverdue": { "label": "% Constraints Overdue",          "good": ["<=", 15],  "watch": ["<=", 30], "text": ["≤ 15%", "16 – 30%", "> 30%"] },
    "constraintsOnTime":  { "label": "% Constraints Resolved On-Time", "good": [">=", 70],  "watch": [">=", 40], "text": ["≥ 70%", "40 – 69%", "< 40%"] },
    "constraintLag":      { "label": "Avg. Constraint Lag (Days)",     "good": ["<=", 7],   "watch": ["<=", 20], "text": ["≤ 7 days", "8 – 20 days", "> 20 days"] },
    "unlinked":           { "label": "% Unlinked Constraints",         "good": ["<=", 30],  "watch": ["<=", 60], "text": ["≤ 30%", "31 – 60%", "> 60%"] },
    "plannedDuration":    { "label": "Planned Duration - 6 Week Avg.", "good": ["<=", 5],   "watch": ["<=", 10], "text": ["≤ 5 days", "6-10 days", "> 10 days"] },
    "compliance":         { "label": "Compliance KPIs (all ten)",      "good": [">=", 90],  "watch": [">=", 70], "text": ["≥ 90%", "70 – 89%", "< 70%"] }
  },

  "reasons": {
    "_comment": "MasterTable 'Reasons for Variance': order = the Text.Contains chain over activityHistory, as [text the history contains, label] (first match wins, case-sensitive). categories group the labels for the charts (here each label is its own category). events = the 'Reasons Category' column, the same kind of chain.",
    "order": [
      ["Space", "Space"], ["Material", "Material"], ["Equipment", "Equipment Unavailable"], ["Manpower", "Manpower"],
      ["Predecessor", "Predecessor"], ["Design", "Design"], ["External", "External"], ["Trade Handover", "Trade Handover"],
      ["Approval", "Sign off/ Approval"], ["Change of Priority", "Change of Priority"], ["Weather", "Weather"], ["Unforeseen Circumstances", "Unforeseen Circumstances"],
      ["Safety Incident", "Safety Incident"], ["Awaiting Information/ Specification", "Awaiting Information/ Specification"], ["Client change request", "Approvals"], ["Access", "Access"],
      ["Organising/ Planning", "Organising/ Planning"], ["Safety", "Safety"]
    ],
    "categories": {
      "Space": ["Space"],
      "Material": ["Material"],
      "Equipment Unavailable": ["Equipment Unavailable"],
      "Manpower": ["Manpower"],
      "Predecessor": ["Predecessor"],
      "Design": ["Design"],
      "External": ["External"],
      "Trade Handover": ["Trade Handover"],
      "Sign off/ Approval": ["Sign off/ Approval"],
      "Change of Priority": ["Change of Priority"],
      "Weather": ["Weather"],
      "Unforeseen Circumstances": ["Unforeseen Circumstances"],
      "Safety Incident": ["Safety Incident"],
      "Awaiting Information/ Specification": ["Awaiting Information/ Specification"],
      "Approvals": ["Approvals"],
      "Access": ["Access"],
      "Organising/ Planning": ["Organising/ Planning"],
      "Safety": ["Safety"]
    },
    "uncategorised": "Uncategorised",
    "noneLabel": "No reason recorded",
    "topCategories": 8,
    "_standard": "MasterTable 'Standard Reason': the coarser grouping of the labels above, used beside 'categories'. A label in no group is 'uncategorised'.",
    "standard": {
      "Outstanding Design": ["Design", "Awaiting Information/ Specification"],
      "Materials": ["Material"],
      "Labour / Resources": ["Manpower"],
      "Plant & Equipment": ["Equipment Unavailable"],
      "Access / Space": ["Space", "Access"],
      "Predecessor Work": ["Predecessor", "Trade Handover"],
      "Client / Approvals": ["Sign off/ Approval", "Approvals"],
      "Health & Safety": ["Safety Incident", "Safety"],
      "External / Weather": ["Weather", "External", "Unforeseen Circumstances"],
      "Planning / Sequencing": ["Change of Priority", "Organising/ Planning"]
    },
    "events": [
      ["started late", "Late Start"],
      ["completed late", "Late Complete"],
      ["stopped At", "Stopped"],
      ["warning by", "Warning"],
      ["rescheduled by", "Rescheduled by"],
      ["Stoppage note", "Stoppage note"],
      ["Warning note", "Warning note"],
      ["Reschedule note", "Reschedule note"],
      ["Note added to task", "Note added"],
      ["created", "New Task"],
      ["copied", "New Task"]
    ]
  },

  "unplanned": {
    "_comment": "Unplanned_Tasks: an activity whose history has a 'New Task' row (reasons.events) dated in its Planned_Week-Year (the ISO week of its planned end). historyDateField = the history row's date in the task feed (epoch ms or dd/mm/yyyy).",
    "historyDateField": "historyDateTime"
  },

  "constraints": {
    "_comment": "AllConstraintsLog Custom2: substring replacements applied in order to category.",
    "categoryReplacements": [
      ["Materials", "Material"], ["Approvals", "Approval"], ["Others", "Other"],
      ["External Conditions", "External"], ["Pre Work Not Complete", "Predecessor"],
      ["1. Delayed / improper materials", "Material"], ["2. Preceding work not completed", "Predecessor"],
      ["Predecessors", "Predecessor"], ["4. Change of priorities", "Predecessor"],
      ["8. Missing / incomplete information", "External"], ["5. Labour shortage", "Manpower"],
      ["9. Missing tools or machinery", "Equipment"], ["Perdecessor", "Predecessor"],
      ["Health and Safety", "Safety"]
    ],
    "tableLimit": 15
  },

  "status": {
    "_comment": "order = series order on the status chart. groups decide the colour class only.",
    "order": ["Complete", "Quality checked", "Started", "Warning", "Stopped", "Rejected at quality check",
              "Ready", "Forced Ready", "Not Ready", "Not Committed"],
    "labels": { "Rejected at quality check": "Rejected at QC" },
    "groups": {
      "complete": ["Complete", "Quality checked"],
      "inProgress": ["Started"],
      "issue": ["Warning", "Stopped", "Rejected at quality check"],
      "ready": ["Ready", "Forced Ready"],
      "notStarted": ["Not Ready", "Not Committed"]
    }
  },

  "compliance": {
    "_comment": "Compliance page. lookaheadWeeks: calendar weeks from next Monday. quantityFields: task feed fields tried in order for the planned (total) quantity; > 0 counts as assigned. updateEvents: [text in the activity history (case-insensitive), label]; any one counts as a progress update. noteMarkers: how a note starts in the history; a note that is only listed reasons (reasons.order) is a default reason, anything else a detailed note.",
    "lookaheadWeeks": 6,
    "quantityFields": ["totalQuantity", "plannedQuantity", "quantity"],
    "updateEvents": [["started", "Started"], ["rescheduled", "Rescheduled"], ["completed", "Completed"]],
    "noteMarkers": ["Note added:", "Note:"],
    "score": {
      "_comment": "Overall VisiLean compliance score: sum of weight x KPI % / sum of the weights used. weights: [path in metrics.compliance, label, weight]; a KPI with nothing to measure (no feed, empty population) is left out and the other weights re-scaled. ratings: [minimum score, label, tone], first match wins.",
      "weights": [
        ["lookahead.owner", "Activities with owners", 10],
        ["lookahead.quantity", "Activities with planned quantities", 10],
        ["lookahead.trade", "Activities with trade assigned", 10],
        ["lookahead.location", "Activities with location assigned", 10],
        ["lookahead.workforce", "Activities with workforce assigned", 10],
        ["delayReasons", "Delayed activities with delay reasons", 10],
        ["constraintOwners", "Constraints with owners", 10],
        ["constraintClosure", "Constraint closure performance", 10],
        ["updates", "Daily progress update compliance", 10],
        ["actualQuantities", "Completed tasks with actual quantities", 10]
      ],
      "ratings": [[95, "Excellent", "good"], [90, "Good", "good"], [80, "Needs improvement", "warn"], [70, "Poor", "warn"], [0, "Critical", "bad"]]
    }
  },

  "unassignedLabel": "Unassigned",
  "groupBy": "organisation",
  "groupByLabel": { "organisation": "organisation", "trade": "trade", "location": "location", "owner": "owner" },
  "breakdown": { "topN": 10 },

  "delayed": {
    "_comment": "buckets are inclusive day ranges of DelayDays; null = open-ended.",
    "buckets": [[1, 7], [8, 14], [15, 30], [31, 60], [61, null]],
    "tableLimit": 25
  }
}
